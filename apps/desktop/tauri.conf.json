{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "buddi-desktop",
  "mainBinaryName": "buddi-desktop",
  "version": "0.1.0",
  "identifier": "com.withbuddi.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "publisher": "buddi",
    "homepage": "https://withbuddi.com",
    "license": "Apache-2.0",
    "category": "Productivity",
    "shortDescription": "Your personal agents, in a window",
    "longDescription": "buddi's desktop app: a window and a tray icon for the buddi installed in your account (curl -fsSL https://withbuddi.com/install.sh | sh). Start at Login (on at first launch) starts it in the tray.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "desktopTemplate": "linux/buddi-desktop.desktop"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
