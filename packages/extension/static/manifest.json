{
  "manifest_version": 3,
  "name": "buddi",
  "version": "0.1.0",
  "description": "Lets your buddi work in this browser, in background tabs grouped under \"buddi\". It needs access to every site because the sites it opens are the ones you ask it for; it opens none on its own.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["tabs", "tabGroups", "scripting", "debugger", "storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "externally_connectable": { "matches": ["http://127.0.0.1/*", "http://localhost/*", "http://[::1]/*"] },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "buddi" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
