{
  "name": "@buddi/core",
  "version": "0.1.0",
  "description": "The contract every buddi plugin is written against: the manifest, the tool registry, the approval machinery and the migration runner.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amenophis1er/buddi.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/amenophis1er/buddi/blob/main/docs/plugins.md",
  "keywords": [
    "buddi",
    "buddi-plugin",
    "agents"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/database-url.d.ts",
      "default": "./dist/testing/database-url.js"
    },
    "./testing/global-setup": {
      "types": "./dist/testing/global-setup.d.ts",
      "default": "./dist/testing/global-setup.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "buddi-migrate": "./dist/cli-migrate.js"
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "age-encryption": "^0.3.1",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "pg-copy-streams": "^7.0.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "@types/pg-copy-streams": "^1.2.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
