{
  "name": "@buddi/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "buddi": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@buddi/core": "workspace:*",
    "@buddi/gateway": "workspace:*",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
