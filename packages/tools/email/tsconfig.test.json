{
  // The same program as `tsconfig.json`, with the tests put back in.
  //
  // `tsconfig.json` excludes `*.test.ts` so that tests are never emitted into
  // `dist`, and for a long time that also meant they were never *checked* —
  // a hand-rolled fake could drift from the interface it stands in for and
  // nothing said so until the assertion failed at runtime, if it failed at
  // all. This project checks them: no emit, same strictness, tests included.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false
  },
  "exclude": []
}
