{
  "name": "@buddi/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "buddi-telegram": "./dist/telegram/main.js",
    "buddi-serve": "./dist/serve.js",
    "buddi-missions": "./dist/missions-cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@buddi/core": "workspace:*",
    "@buddi/runtime": "workspace:*",
    "@buddi/tool-artifacts": "workspace:*",
    "@buddi/tool-browser": "workspace:*",
    "@buddi/tool-email": "workspace:*",
    "@buddi/tool-host": "workspace:*",
    "@buddi/tool-memory": "workspace:*",
    "@buddi/tool-web": "workspace:*",
    "@resvg/resvg-wasm": "^2.6.2",
    "dotenv": "^16.4.7",
    "jpeg-js": "^0.4.4",
    "omggif": "^1.0.10",
    "pg": "^8.13.1",
    "pngjs": "^7.0.0",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/omggif": "^1.0.5",
    "@types/pg": "^8.11.10",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "playwright": "^1.58.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
