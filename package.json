{
  "name": "buddi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/check-boundaries.mjs && pnpm -r build && pnpm -r typecheck && pnpm -r test && pnpm check:generic",
    "check:generic": "pnpm --filter @buddi/gateway exec vitest run src/generic-install.test.ts",
    "eval": "pnpm -r build && node packages/gateway/dist/evals/golden.js",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/migrate.mjs",
    "chat": "node packages/cli/dist/main.js chat",
    "ask": "node packages/cli/dist/main.js ask",
    "telegram": "node packages/gateway/dist/telegram/main.js",
    "serve": "node packages/cli/dist/main.js serve",
    "missions": "node packages/cli/dist/main.js missions",
    "agents": "node packages/cli/dist/main.js agents",
    "link": "node scripts/link-cli.mjs",
    "unlink": "pnpm remove --global @buddi/cli",
    "dev:refresh": "pnpm -r build && node packages/cli/dist/main.js migrate && node packages/cli/dist/main.js service restart",
    "dev:install": "pnpm -r build && pnpm run link && node packages/cli/dist/main.js migrate && node packages/cli/dist/main.js service install",
    "buddi": "node packages/cli/dist/main.js",
    "doctor": "node packages/cli/dist/main.js doctor",
    "init": "node packages/cli/dist/main.js init"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@buddi/core": "workspace:*",
    "dotenv": "^16.4.7"
  }
}
