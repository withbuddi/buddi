DATABASE_URL=postgres://buddi:buddi@localhost:5432/buddi
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Optional: host port for the postgres container (default 5432).
# Set this and the port in DATABASE_URL together if 5432 is already taken.
# BUDDI_DB_PORT=5432

# Optional: the owner's timezone (IANA name, default America/New_York).
# It is the day "today" means to every agent and tool, and the zone scheduled
# missions fire in.
# BUDDI_TZ=America/New_York

# Optional: what the agents call you. `buddi init` asks for it.
# BUDDI_OWNER_NAME=

# Telegram surface (optional). Ask @BotFather for a bot token, then pair a
# device with `buddi telegram pair`.
# TELEGRAM_BOT_TOKEN=
