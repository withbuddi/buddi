# The database. There is deliberately no password here.
#
# buddi generates one at `buddi init` (or on the first `buddi db up`), keeps it
# in the OS keychain under BUDDI_DB_PASSWORD, and assembles DATABASE_URL around
# it at runtime — so no file on this machine holds the credential to your
# financial history, your mail and your conversations.
#
# The escape hatch: set DATABASE_URL here and it wins over everything. That is
# for running your own Postgres; buddi will then neither generate nor rotate a
# password, because it did not issue that one.
# DATABASE_URL=postgres://user:password@host:5432/buddi

# The model credential. Set ONE of these two: with a Claude subscription run
# `claude setup-token` and paste the result into CLAUDE_CODE_OAUTH_TOKEN,
# otherwise use an API key. Nothing is discovered — an agent names the variable
# it wants, and resolution fails closed when it is missing or empty.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Optional: the model Anthropic agents get when their own file pins none
# (default claude-sonnet-5). It is an *Anthropic* model name and is never
# handed to the other provider. Per-agent: `buddi agents set <handle> --model`.
# BUDDI_MODEL=claude-sonnet-5

# Second provider (optional). Only the agents whose file pins `provider: openai`
# read this — @scout ships that way. Leave it empty and @scout is listed as
# unavailable; every other agent is unaffected. There is no subscription-token
# form here and no fallback to the Anthropic key.
# OPENAI_API_KEY=
# BUDDI_OPENAI_MODEL=gpt-5

# Optional: host port for the postgres container (default 5432). Set it alone —
# the assembled DATABASE_URL reads it. Only set the port in DATABASE_URL too if
# you are also setting DATABASE_URL by hand.
#
# The container publishes on 127.0.0.1 only (see docker-compose.yml). The one
# legitimate reason to change that is reaching this database from another
# machine of your own over a *private* network — a Tailscale or WireGuard
# address. Never bind it to 0.0.0.0 on a network you do not control.
# BUDDI_DB_PORT=5432

# Optional: the owner's timezone (IANA name, default America/New_York).
# It is the day "today" means to every agent and tool, and the zone scheduled
# missions fire in.
# BUDDI_TZ=America/New_York

# Optional: what the agents call you. `buddi init` asks for it.
# BUDDI_OWNER_NAME=

# Telegram surface (optional). Ask @BotFather for a bot token, then pair a
# device with `buddi telegram pair`.
# TELEGRAM_BOT_TOKEN=

# Email plugin (optional). One Gmail account, app password for v1 — Gmail OAuth
# refresh tokens for an unpublished app expire weekly, which is unusable for an
# unattended system. An app password is a full-mailbox bearer secret: it is not
# available under Advanced Protection and is revoked by a password change.
# With GMAIL_USER unset the plugin is installed but has nothing to poll, which
# is a valid running state.
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=

# Reminders (optional). The budget an agent's own `reminder.set` is held to.
# Enforced in code, not in a prompt; the tool's description is built from these
# numbers, so the agent is told the limits this installation actually has.
# Out-of-range values are clamped, unparseable ones ignored — either way the
# default is used and the reason is logged once at startup.
# BUDDI_REMINDER_MIN_LEAD_MINUTES=5     # how far out a reminder must be (1..1440)
# BUDDI_REMINDER_MAX_HORIZON_DAYS=365   # how far out a reminder may be (1..3650)
# BUDDI_REMINDER_MAX_PENDING_PER_AGENT=10  # pending reminders one agent may hold (1..100)
# BUDDI_REMINDER_MAX_PENDING_TOTAL=25      # pending reminders across every agent (1..500)

# Local dashboard (optional). Served by `buddi serve`; open it with
# `buddi dashboard`. The session token is generated on first run and kept in the
# vault under BUDDI_WEB_TOKEN (or data/web-token, mode 600, where there is no
# vault) — you never need to set it here.
# BUDDI_WEB=1             # 0 turns the dashboard off entirely
# BUDDI_WEB_HOST=127.0.0.1  # anything but loopback exposes an approval button
# BUDDI_WEB_PORT=4317

# Secrets: the vault comes first, these lines are the day-1 fallback.
# `buddi vault import-env` moves the secrets above into the OS keychain and
# rewrites each line here to NAME="<vault>", which buddi reads as "ask the vault".
# The quotes are deliberate: unquoted, `<` is a shell redirection and `. ./.env`
# would fail — dotenv strips them, so both spellings mean the same to buddi.
# BUDDI_VAULT=keychain   # keychain (macOS default) | file | memory | none
# BUDDI_VAULT_KEY=       # required by the file vault; it IS the key, keep it out of the repo
# BUDDI_VAULT_FILE=      # where the file vault lives (default ~/.buddi/vault.json)
